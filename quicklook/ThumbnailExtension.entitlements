<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- WKWebView's helper processes will not launch without this, even offline. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- WebKit's WebContent process aborts in _RegisterApplication when it cannot
	     reach the WindowServer, which is the situation a thumbnail extension runs
	     in. This exception is the only lever available from our side. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>com.apple.windowserver.active</string>
		<string>com.apple.coreservices.launchservicesd</string>
	</array>
</dict>
</plist>
